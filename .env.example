# Server-only. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
APP_ORIGIN=https://relay-chi-ecru.vercel.app
ALLOWED_GOOGLE_EMAILS=
# Exact comma-separated addresses only (no empty entries or wildcards).
# Every admin must also appear in ALLOWED_GOOGLE_EMAILS. Invalid/empty settings grant no admin access.
# Validate securely loaded settings with npm run check:auth-config.
ADMIN_GOOGLE_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Neon pooler or Supabase transaction-pooler URL; TLS verification is required.
DATABASE_URL=
# Use a dedicated migration-owner connection, not a browser key.
MIGRATION_DATABASE_URL=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 32 random bytes, encoded as base64. Server-only; do not rotate without re-encrypting saved tokens.
TOKEN_ENCRYPTION_KEY=

# CRM uses a separate non-owner login inheriting relay_crm_runtime. No fallback to DATABASE_URL.
CRM_DATABASE_URL=
