{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/relay.mjs": {
      "includeFiles": "prototype/{index.html,assets/app.js}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/manifest.webmanifest",
      "headers": {
        "Content-Type": "application/manifest+json",
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/api/relay?route=page"
    },
    {
      "src": "/login",
      "dest": "/api/relay?route=login-page"
    },
    {
      "src": "/admin",
      "dest": "/api/relay?route=admin-page"
    },
    {
      "src": "/api/admin/overview",
      "dest": "/api/relay?route=admin-overview"
    },
    {
      "src": "/index.html",
      "dest": "/api/relay?route=page"
    },
    {
      "src": "/assets/app.js",
      "dest": "/api/relay?route=app"
    },
    {
      "src": "/api/session",
      "dest": "/api/relay?route=session"
    },
    {
      "src": "/api/auth/start",
      "dest": "/api/relay?route=start"
    },
    {
      "src": "/api/auth/callback",
      "dest": "/api/relay?route=callback"
    },
    {
      "src": "/api/auth/logout",
      "dest": "/api/relay?route=logout"
    },
    {
      "src": "/api/line/destinations",
      "dest": "/api/relay?route=destinations"
    },
    {
      "src": "/api/line/code",
      "dest": "/api/relay?route=code"
    },
    {
      "src": "/api/line/destination",
      "dest": "/api/relay?route=destination"
    },
    {
      "src": "/api/line/notify",
      "dest": "/api/relay?route=notify"
    },
    {
      "src": "/api/line/webhook",
      "dest": "/api/relay?route=webhook"
    },
    {
      "src": "/api/calendar/status",
      "dest": "/api/relay?route=calendar-status"
    },
    {
      "src": "/api/calendar/connect",
      "dest": "/api/relay?route=calendar-connect"
    },
    {
      "src": "/api/calendar/callback",
      "dest": "/api/relay?route=calendar-callback"
    },
    {
      "src": "/api/calendar/disconnect",
      "dest": "/api/relay?route=calendar-disconnect"
    },
    {
      "src": "/api/schedule/propose",
      "dest": "/api/relay?route=schedule-propose"
    },
    {
      "src": "/api/schedule/book",
      "dest": "/api/relay?route=schedule-book"
    },
    {
      "src": "/api/mcp",
      "dest": "/api/relay?route=mcp"
    },
    {
      "src": "/api/mcp/tokens",
      "dest": "/api/relay?route=mcp-tokens"
    },
    {
      "src": "/api/mcp/token",
      "dest": "/api/relay?route=mcp-token"
    },
    {
      "src": "/api/mcp/revoke",
      "dest": "/api/relay?route=mcp-revoke"
    },
    {
      "src": "/api/crm/workspaces",
      "dest": "/api/relay?route=crm-workspaces"
    },
    {
      "src": "/api/crm/customers",
      "dest": "/api/relay?route=crm-customers"
    },
    {
      "src": "/api/crm/customers/search",
      "dest": "/api/relay?route=crm-search"
    },
    {
      "src": "/api/crm/contacts",
      "dest": "/api/relay?route=crm-contacts"
    },
    {
      "src": "/api/crm/customers/([0-9a-fA-F-]+)/contacts",
      "dest": "/api/relay?route=crm-customer-contacts&id=$1"
    },
    {
      "src": "/api/crm/customers/([0-9a-fA-F-]+)",
      "dest": "/api/relay?route=crm-customer&id=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
